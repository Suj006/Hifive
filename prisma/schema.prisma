// Prisma schema for Hi Five by Jia — raw material purchase & product sale ledger
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ItemType {
  RAW_MATERIAL
  PRODUCT
}

enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Audience/segment master for finished products — e.g. Kids, Adults, Male, Female.
// The same product name can exist once per category (each is tracked as its own
// stock line), so "Charm Bracelet" for Kids and for Adults are separate Items.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  items     Item[]
}

// Master list of finished-product names — e.g. Bracelet, Chain, Keychain, Bow.
// Selected (not free-typed) when adding a PRODUCT item, so the same product
// can't be entered under slightly different spellings.
model ProductName {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Master list of raw material names — e.g. Silk Thread — Pink, Metal Charm —
// Heart. Same idea as ProductName: selected (not free-typed) when adding a
// RAW_MATERIAL item, so the same material isn't entered under slightly
// different spellings each time.
model RawMaterialName {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Discount codes an admin can create — either a percentage off (with an
// optional rupee cap) or a flat rupee amount. Applied to a Sale by code.
model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. ONAM2026 — always stored uppercase
  discountType String // "PERCENT" | "FLAT"
  value        Float // percent (0-100) if PERCENT, else a flat rupee amount
  maxDiscount  Float? // caps the rupee discount — only meaningful for PERCENT
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
}

model Item {
  id           String    @id @default(cuid())
  code         String    @unique // auto-generated, e.g. RM-0001 / PD-0001
  name         String
  type         ItemType
  unit         String // e.g. pcs, gm, meter, box
  group        String? // loose free-text tag, e.g. Beads, Thread, Bracelet, Keychain
  categoryId   String? // audience/segment, mainly for PRODUCT items
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Normalized dedupe key (name + type + category), enforced unique so the same
  // item/category combination can't be created twice. Computed server-side.
  variantKey   String    @unique
  openingStock Float     @default(0)
  reorderLevel Float     @default(0)
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  purchases    Purchase[]
  sales        Sale[]
  productions  Production[]

  @@index([type])
  @@index([categoryId])
}

model Vendor {
  id        String     @id @default(cuid())
  code      String     @unique // auto-generated, e.g. VEND-0001
  name      String     @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique // auto-generated, e.g. CUST-0001
  name      String
  phone     String?  @unique // same phone can't be used for two different customers
  email     String?
  address   String?
  notes     String?
  // Only month/day are collected (no year) — customers are more willing to
  // share this for birthday greetings than a full date they'd use to infer age.
  dobMonth  Int?
  dobDay    Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Purchase {
  id            String   @id @default(cuid())
  date          DateTime
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  quantity      Float
  rate          Float // per unit rate in INR
  amount        Float // quantity * rate (+ any adjustment), stored for auditability
  invoiceNumber String?
  paymentMode   String? // Cash, UPI, Bank Transfer, Card
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([itemId])
  @@index([vendorId])
  @@index([date])
}

model Sale {
  id            String   @id @default(cuid())
  date          DateTime
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quantity      Float
  rate          Float // per unit selling price in INR
  amount        Float // quantity * rate (+ any adjustment), stored for auditability
  // How much of `amount` has actually been received — defaults to the full
  // amount (paid in full) unless a partial payment is recorded, so
  // `amount - amountPaid` is the outstanding due for this sale.
  amountPaid    Float    @default(0)
  // `discount` is either a rupee amount or a percentage of quantity*rate,
  // depending on discountType — historical rows default to FLAT so their
  // existing rupee-denominated values keep meaning what they always meant.
  discount      Float    @default(0)
  discountType  String   @default("FLAT") // "FLAT" | "PERCENT"
  couponId      String?
  coupon        Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // Snapshot of the coupon's code at the time of sale, so it still reads
  // correctly even if the coupon is later renamed or deleted.
  couponCode    String?
  // Actual rupee amount the coupon discounted (after any max-discount cap),
  // stored for audit/invoice display since a PERCENT coupon's raw `value`
  // alone wouldn't say what it worked out to in rupees for this sale.
  couponDiscount Float   @default(0)
  invoiceNumber String?
  paymentMode   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([itemId])
  @@index([customerId])
  @@index([date])
  @@index([couponId])
}

// Any spend that isn't a raw material purchase — packaging, shipping, rent,
// tools, marketing… — so Net Profit on the Dashboard reflects real running
// costs, not just purchases vs sales.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  description String
  amount      Float
  paymentMode String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// Production run: raw materials are turned into finished products. Each entry
// adds to that product's available stock, the same way a Purchase adds to a
// raw material's stock.
model Production {
  id        String   @id @default(cuid())
  date      DateTime
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([date])
}
