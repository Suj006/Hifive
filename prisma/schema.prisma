// Prisma schema for Hi Five by Jia — raw material purchase & product sale ledger
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ItemType {
  RAW_MATERIAL
  PRODUCT
}

// Audience/segment master for finished products — e.g. Kids, Adults, Male, Female.
// The same product name can exist once per category (each is tracked as its own
// stock line), so "Charm Bracelet" for Kids and for Adults are separate Items.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  items     Item[]
}

model Item {
  id           String    @id @default(cuid())
  code         String    @unique // auto-generated, e.g. RM-0001 / PD-0001
  name         String
  type         ItemType
  unit         String // e.g. pcs, gm, meter, box
  group        String? // loose free-text tag, e.g. Beads, Thread, Bracelet, Keychain
  categoryId   String? // audience/segment, mainly for PRODUCT items
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Normalized dedupe key (name + type + category), enforced unique so the same
  // item/category combination can't be created twice. Computed server-side.
  variantKey   String    @unique
  openingStock Float     @default(0)
  reorderLevel Float     @default(0)
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  purchases    Purchase[]
  sales        Sale[]

  @@index([type])
  @@index([categoryId])
}

model Vendor {
  id        String     @id @default(cuid())
  name      String     @unique
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Purchase {
  id            String   @id @default(cuid())
  date          DateTime
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  quantity      Float
  rate          Float // per unit rate in INR
  amount        Float // quantity * rate (+ any adjustment), stored for auditability
  invoiceNumber String?
  paymentMode   String? // Cash, UPI, Bank Transfer, Card
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([itemId])
  @@index([vendorId])
  @@index([date])
}

model Sale {
  id            String   @id @default(cuid())
  date          DateTime
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quantity      Float
  rate          Float // per unit selling price in INR
  amount        Float // quantity * rate (+ any adjustment), stored for auditability
  discount      Float    @default(0)
  invoiceNumber String?
  paymentMode   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([itemId])
  @@index([customerId])
  @@index([date])
}
