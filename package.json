{
  "name": "hifive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-backup.js dev",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && node scripts/run-with-backup.js start",
    "backup": "node -e \"console.log(require('./scripts/backup-db').backupDatabase() || 'No database file found to back up.')\"",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "html-to-image": "^1.11.13",
    "next": "16.3.5",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
